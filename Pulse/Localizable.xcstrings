          }
        }
      }
    },
    "Your workout count is down from %lld last month to %lld so far. Training at least 2–3 times per week is enough to maintain and build strength.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Workout-Anzahl ist von %lld letzten Monat auf %lld bisher gesunken. Mindestens 2–3 Mal pro Woche zu trainieren reicht aus, um Kraft zu erhalten und aufzubauen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Your workout count is down from %1$lld last month to %2$lld so far. Training at least 2–3 times per week is enough to maintain and build strength."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cantidad de entrenamientos bajó de %lld el mes pasado a %lld hasta ahora. Entrenar al menos 2–3 veces por semana es suficiente para mantener y ganar fuerza."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cantidad de entrenamientos bajó de %lld el mes pasado a %lld hasta ahora. Entrenar al menos 2–3 veces por semana es suficiente para mantener y ganar fuerza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua contagem de treinos caiu de %lld no mês passado para %lld até agora. Treinar pelo menos 2–3 vezes por semana é suficiente para manter e ganhar força."
          }
        }
      }
    },
    "Your workout keeps tracking even with the screen off.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
