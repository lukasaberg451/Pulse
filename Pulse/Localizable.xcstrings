    "Your workout count is down from %lld last month to %lld so far. Training at least 2–3 times per week is enough to maintain and build strength." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Workout-Anzahl ist von %lld letzten Monat auf %lld bisher gesunken. Mindestens 2–3 Mal pro Woche zu trainieren reicht aus, um Kraft zu erhalten und aufzubauen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your workout count is down from %1$lld last month to %2$lld so far. Training at least 2–3 times per week is enough to maintain and build strength."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cantidad de entrenamientos bajó de %lld el mes pasado a %lld hasta ahora. Entrenar al menos 2–3 veces por semana es suficiente para mantener y ganar fuerza."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cantidad de entrenamientos bajó de %lld el mes pasado a %lld hasta ahora. Entrenar al menos 2–3 veces por semana es suficiente para mantener y ganar fuerza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton nombre d'entraînements est passé de %lld le mois dernier à %lld jusqu'ici. S'entraîner au moins 2–3 fois par semaine suffit pour maintenir et développer ta force."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークアウト回数が先月の%lld回から現在%lld回に減少しています。週に2〜3回のトレーニングで筋力の維持・向上には十分です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "운동 횟수가 지난달 %lld회에서 현재 %lld회로 줄었습니다. 주 2-3회 이상 훈련하면 근력을 유지하고 키우는 데 충분합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je aantal trainingen is gedaald van %lld vorige maand naar %lld tot nu toe. Minimaal 2-3 keer per week trainen is genoeg om kracht te behouden en op te bouwen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua contagem de treinos caiu de %lld no mês passado para %lld até agora. Treinar pelo menos 2–3 vezes por semana é suficiente para manter e ganhar força."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt antal träningspass har sjunkit från %lld förra månaden till %lld hittills. Att träna minst 2–3 gånger per vecka räcker för att behålla och bygga styrka."
          }
        }
      }
    },
