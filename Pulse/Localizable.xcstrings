    "Workouts can only be started from the routine during offline mode. Your workout will sync when you're back online.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trainings können im Offline-Modus nur über die Routine gestartet werden. Dein Training wird synchronisiert, sobald du wieder online bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los entrenamientos solo se pueden iniciar desde la rutina en modo sin conexión. Tu entrenamiento se sincronizará cuando vuelvas a estar en línea."
          }
        },
        "es-419": {
          "stringUnit": {
