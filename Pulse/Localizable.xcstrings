    "Your training volume is down %lld%% from last month. If you're deloading intentionally that's great, otherwise try to maintain or gradually increase load.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Trainingsvolumen ist %lld%% niedriger als letzten Monat. Wenn du absichtlich deloadest, ist das großartig – ansonsten versuche, die Belastung beizubehalten oder schrittweise zu steigern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu volumen de entrenamiento bajó un %lld%% respecto al mes pasado. Si estás descargando intencionalmente, genial; de lo contrario, intenta mantener o aumentar gradualmente la carga."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu volumen de entrenamiento bajó un %lld%% respecto al mes pasado. Si estás descargando intencionalmente, genial; de lo contrario, intenta mantener o aumentar gradualmente la carga."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu volume de treino caiu %lld%% em relação ao mês passado. Se você está fazendo deload intencionalmente, ótimo; caso contrário, tente manter ou aumentar gradualmente a carga."
          }
        }
      }
    },
    "Your training volume is up %lld%% from last month. Gradual progressive overload is the primary driver of muscle hypertrophy.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Trainingsvolumen ist %lld%% gegenüber letztem Monat gestiegen. Schrittweise progressive Überlastung ist der Haupttreiber für Muskelhypertrophie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu volumen de entrenamiento subió %lld%% respecto al mes pasado. La sobrecarga progresiva gradual es el principal impulsor de la hipertrofia muscular."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu volumen de entrenamiento subió %lld%% respecto al mes pasado. La sobrecarga progresiva gradual es el principal impulsor de la hipertrofia muscular."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu volume de treino subiu %lld%% em relação ao mês passado. A sobrecarga progressiva gradual é o principal fator para a hipertrofia muscular."
          }
        }
      }
    },
    "Your version of Pulse is no longer supported. Please update to continue using the app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Version von Pulse wird nicht mehr unterstützt. Bitte aktualisiere die App, um sie weiter zu nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
