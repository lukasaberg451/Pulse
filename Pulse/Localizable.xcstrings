        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld주 연속 기록이 끝났지만, 쌓아온 근력은 사라지지 않았습니다. 이번 주 %2$lld회 운동으로 새로운 기록을 시작하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je reeks van %1$lld weken is beëindigd, maar de kracht die je hebt opgebouwd is niet verdwenen. Doe deze week %2$lld trainingen om een nieuwe te starten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua sequência de %1$lld semanas terminou, mas a força que você construiu não desapareceu. Faça %2$lld treinos esta semana para começar uma nova."
