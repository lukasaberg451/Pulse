    "Subscription automatically renews unless cancelled at least 24 hours before the end of the current period." : {
      "comment" : "Subscription disclaimer",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Abonnement verlängert sich automatisch, wenn es nicht mindestens 24 Stunden vor Ablauf des aktuellen Zeitraums gekündigt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suscripción se renueva automáticamente a menos que se cancele al menos 24 horas antes del final del período actual."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suscripción se renueva automáticamente a menos que se cancele al menos 24 horas antes del final del período actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'abonnement se renouvelle automatiquement sauf annulation au moins 24 heures avant la fin de la période en cours."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブスクリプションは現在の期間終了の24時間前までにキャンセルしない限り自動更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 기간 종료 최소 24시간 전에 취소하지 않으면 구독이 자동으로 갱신됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnement wordt automatisch verlengd tenzij minstens 24 uur voor het einde van de huidige periode opgezegd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
