          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이번 달 %lld회 운동%@을 기록했고 전체 %lld회입니다. 꾸준함이 단기적 노력과 지속적인 성과를 구분합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt %lld training%@ deze maand gelogd en %lld totaal. Consistent blijven is wat kortdurende inspanning onderscheidt van blijvende resultaten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você registrou %lld treino%@ este mês e %lld no total. Ser consistente é o que separa o esforço a curto prazo de resultados duradouros."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
