    "This will permanently delete your weight, height, target weight, and all weight history. This action cannot be undone." : {
      "comment" : "Delete body metrics confirmation message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden dein Gewicht, deine Größe, dein Zielgewicht und dein gesamter Gewichtsverlauf dauerhaft gelöscht. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
