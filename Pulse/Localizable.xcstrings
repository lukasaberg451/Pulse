    "Are you sure you want to delete '%@'? All past workouts related to the routine will not be deleted. This action cannot be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du '%@' wirklich löschen? Alle vergangenen Workouts dieser Routine bleiben erhalten. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás seguro de que quieres eliminar '%@'? Todos los entrenamientos anteriores relacionados con la rutina no se eliminarán. Esta acción no se puede deshacer."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás seguro de que quieres eliminar '%@'? Todos los entrenamientos anteriores relacionados con la rutina no se eliminarán. Esta acción no se puede deshacer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza que deseja excluir '%@'? Todos os treinos anteriores relacionados à rotina não serão excluídos. Esta ação não pode ser desfeita."
          }
        }
      }
    },
    "Are you sure you want to delete '%@'? This will remove the exercise from routines, stats and all past workouts. This action cannot be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du '%@' wirklich löschen? Die Übung wird aus Routinen, Statistiken und allen vergangenen Workouts entfernt. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás seguro de que quieres eliminar '%@'? Esto eliminará el ejercicio de las rutinas, estadísticas y todos los entrenamientos anteriores. Esta acción no se puede deshacer."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás seguro de que quieres eliminar '%@'? Esto eliminará el ejercicio de las rutinas, estadísticas y todos los entrenamientos anteriores. Esta acción no se puede deshacer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza que deseja excluir '%@'? Isso removerá o exercício das rotinas, estatísticas e todos os treinos anteriores. Esta ação não pode ser desfeita."
          }
        }
      }
    },
