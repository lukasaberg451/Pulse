        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden dein Gewicht, deine Größe, dein Zielgewicht und dein gesamter Gewichtsverlauf dauerhaft gelöscht. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
