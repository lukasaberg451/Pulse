    "Let's take a quick tour to help you get the most out of your training. Tap Next to get started!" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass uns eine kurze Tour machen, damit du das Beste aus deinem Training herausholen kannst. Tippe auf Weiter, um loszulegen!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hagamos un recorrido rápido para ayudarte a aprovechar al máximo tu entrenamiento. ¡Toca Siguiente para empezar!"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
