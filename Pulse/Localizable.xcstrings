    "You can now sign in with your new password." : {
      "comment" : "Success message after password reset",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst dich jetzt mit deinem neuen Passwort anmelden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora puedes iniciar sesión con tu nueva contraseña."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora puedes iniciar sesión con tu nueva contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux maintenant te connecter avec ton nouveau mot de passe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいパスワードでログインできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 새 비밀번호로 로그인할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt nu inloggen met je nieuwe wachtwoord."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agora você pode entrar com sua nova senha."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan nu logga in med ditt nya lösenord."
          }
        }
      }
    },
    "You can't reuse your previous password. Please choose a new one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst dein vorheriges Passwort nicht wiederverwenden. Bitte wähle ein neues."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No puedes reutilizar tu contraseña anterior. Por favor, elige una nueva."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No puedes reutilizar tu contraseña anterior. Por favor, elige una nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ne peux pas réutiliser ton ancien mot de passe. Choisis-en un nouveau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前のパスワードは再利用できません。新しいパスワードを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전 비밀번호는 재사용할 수 없습니다. 새 비밀번호를 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt je vorige wachtwoord niet hergebruiken. Kies een nieuw wachtwoord."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não pode reutilizar sua senha anterior. Por favor, escolha uma nova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan inte återanvända ditt tidigare lösenord. Välj ett nytt."
          }
        }
      }
    },
    "You have %lld workout%@ under your belt. Kick this month off with a session. Momentum builds fast once you start." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast %lld Training%@ hinter dir. Starte diesen Monat mit einer Einheit. Schwung baut sich schnell auf, sobald du anfängst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have %1$lld workout%2$@ under your belt. Kick this month off with a session. Momentum builds fast once you start."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes %lld entrenamiento%@ en tu haber. Comienza este mes con una sesión. El impulso se construye rápido una vez que empiezas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes %lld entrenamiento%@ en tu haber. Comienza este mes con una sesión. El impulso se construye rápido una vez que empiezas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as %lld entraînement%@ à ton actif. Lance ce mois avec une séance. L'élan se construit vite une fois commencé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lldのワークアウト%@を達成しました。今月もセッションでスタートしましょう。始めれば勢いはすぐにつきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld번의 운동%@을 해냈습니다. 이번 달을 세션으로 시작하세요. 시작하면 탄력이 빠르게 붙습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt %lld training%@ op je naam. Begin deze maand met een sessie. Momentum bouwt snel op zodra je start."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você tem %lld treino%@ no currículo. Comece este mês com uma sessão. O ritmo se constrói rápido quando você começa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har %lld träningspass%@ bakom dig. Starta månaden med ett pass. Farten byggs snabbt när du väl börjar."
          }
        }
      }
    },
    "You have an unfinished \"%@\" workout from %lld minutes ago. Would you like to continue?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast ein unvollständiges '%1$@'-Workout von vor %2$lld Minuten. Möchtest du fortfahren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have an unfinished \"%1$@\" workout from %2$lld minutes ago. Would you like to continue?"
          }
        },
        "es" : {
