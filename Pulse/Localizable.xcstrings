          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld週間の連続記録は途切れましたが、築いた筋力は消えていません。今週%2$lld回のワークアウトで新しい記録を始めましょう。"
