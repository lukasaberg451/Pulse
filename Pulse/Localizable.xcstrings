    "It's been %lld days since your last session. Strength can decline after 72 hours of inactivity. Even a light workout helps maintain your gains.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es sind %lld Tage seit deiner letzten Einheit vergangen. Kraft kann nach 72 Stunden Inaktivität abnehmen. Selbst ein leichtes Training hilft, deine Fortschritte zu erhalten."
          }
        },
        "es": {
          "stringUnit": {
