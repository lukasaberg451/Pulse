    "%@ makes up %@ of your sets this month. Uneven training can create strength imbalances. Consider adding work for opposing muscle groups." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ macht %2$@ deiner Sätze diesen Monat aus. Ungleichmäßiges Training kann Kraft-Ungleichgewichte erzeugen. Erwäge, Übungen für die gegenüberliegenden Muskelgruppen hinzuzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ makes up %2$@ of your sets this month. Uneven training can create strength imbalances. Consider adding work for opposing muscle groups."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ representa el %2$@ de tus series este mes. El entrenamiento desigual puede crear desequilibrios de fuerza. Considera añadir trabajo para los grupos musculares opuestos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ representa el %2$@ de tus series este mes. El entrenamiento desigual puede crear desequilibrios de fuerza. Considera agregar trabajo para los grupos musculares opuestos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ représente %2$@ de tes séries ce mois-ci. Un entraînement déséquilibré peut créer des déséquilibres de force. Pense à travailler les groupes musculaires opposés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@は今月のセット数の%2$@を占めています。偏ったトレーニングは筋力のアンバランスを生む可能性があります。反対側の筋群のトレーニングも検討しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@이(가) 이번 달 세트의 %2$@를 차지합니다. 불균형한 훈련은 근력 불균형을 만들 수 있습니다. 반대 근육군 운동을 추가해 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ maakt %2$@ uit van je sets deze maand. Ongelijkmatige training kan krachtonevenwichtigheden veroorzaken. Overweeg om oefeningen voor tegenovergestelde spiergroepen toe te voegen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ representa %2$@ das suas séries este mês. Treino desigual pode criar desequilíbrios de força. Considere adicionar exercícios para os grupos musculares opostos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ utgör %2$@ av dina set denna månad. Ojämn träning kan skapa styrkebalans. Överväg att lägga till övningar för motverkande muskelgrupper."
          }
        }
      }
    },
