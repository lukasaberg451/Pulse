    "Subscription automatically renews unless canceled." : {
      "comment" : "Subscription disclaimer",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnement verlängert sich automatisch, wenn es nicht gekündigt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suscripción se renueva automáticamente a menos que se cancele."
