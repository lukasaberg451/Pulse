    "Create workout routines, add exercises, configure target reps and sets, and customize them to match your goals." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle Trainingsroutinen, füge Übungen hinzu, konfiguriere Zielwiederholungen und Sätze und passe sie an deine Ziele an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea rutinas de entrenamiento, añade ejercicios, configura repeticiones y series objetivo, y personalízalas según tus metas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
