    "Workout sharing was not enabled. To allow this later, go to the Health app → Sharing → Apps and grant access to Pulse." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Workout-Freigabe wurde nicht aktiviert. Um dies später zu erlauben, gehe zur Health-App → Freigabe → Apps und gewähre Pulse Zugriff."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se habilitó compartir entrenamientos. Para permitirlo después, ve a la app Salud → Compartir → Apps y concede acceso a Pulse."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se habilitó compartir entrenamientos. Para permitirlo después, ve a la app Salud → Compartir → Apps y da acceso a Pulse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
