    "You can now sign in with your new password.": {
      "comment": "Success message after password reset",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst dich jetzt mit deinem neuen Passwort anmelden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora puedes iniciar sesión con tu nueva contraseña."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora puedes iniciar sesión con tu nueva contraseña."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora você pode entrar com sua nova senha."
          }
        }
      }
    },
    "You can't reuse your previous password. Please choose a new one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst dein vorheriges Passwort nicht wiederverwenden. Bitte wähle ein neues."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedes reutilizar tu contraseña anterior. Por favor, elige una nueva."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedes reutilizar tu contraseña anterior. Por favor, elige una nueva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não pode reutilizar sua senha anterior. Por favor, escolha uma nova."
          }
        }
      }
    },
    "You have %lld workout%@ under your belt. Kick this month off with a session. Momentum builds fast once you start.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You have %1$lld workout%2$@ under your belt. Kick this month off with a session. Momentum builds fast once you start."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %lld Training%@ hinter dir. Starte diesen Monat mit einer Einheit. Schwung baut sich schnell auf, sobald du anfängst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes %lld entrenamiento%@ en tu haber. Comienza este mes con una sesión. El impulso se construye rápido una vez que empiezas."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes %lld entrenamiento%@ en tu haber. Comienza este mes con una sesión. El impulso se construye rápido una vez que empiezas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você tem %lld treino%@ no currículo. Comece este mês com uma sessão. O ritmo se constrói rápido quando você começa."
          }
        }
      }
    },
    "You have an unfinished \"%@\" workout from %lld minutes ago. Would you like to continue?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast ein unvollständiges '%1$@'-Workout von vor %2$lld Minuten. Möchtest du fortfahren?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You have an unfinished \"%1$@\" workout from %2$lld minutes ago. Would you like to continue?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes un entrenamiento \"%1$@\" sin terminar de hace %2$lld minutos. ¿Quieres continuar?"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes un entrenamiento \"%1$@\" sin terminar de hace %2$lld minutos. ¿Quieres continuar?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você tem um treino \"%1$@\" inacabado de %2$lld minutos atrás. Deseja continuar?"
          }
        }
      }
    },
    "You haven't trained this week yet. Even one session before the weekend helps maintain the progress you've built.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast diese Woche noch nicht trainiert. Selbst eine Einheit vor dem Wochenende hilft, den aufgebauten Fortschritt zu erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No has entrenado esta semana todavía. Incluso una sesión antes del fin de semana ayuda a mantener el progreso que has construido."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No has entrenado esta semana todavía. Incluso una sesión antes del fin de semana ayuda a mantener el progreso que has construido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ainda não treinou esta semana. Mesmo uma sessão antes do fim de semana ajuda a manter o progresso que você construiu."
          }
        }
      }
    },
    "You need at least 2 personal records logged to see your 1RM progression chart.": {
      "comment": "Empty chart state",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du benötigst mindestens 2 eingetragene persönliche Rekorde, um dein 1RM-Verlaufsdiagramm zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesitas al menos 2 récords personales registrados para ver tu gráfico de progresión 1RM."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesitas al menos 2 récords personales registrados para ver tu gráfico de progresión 1RM."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você precisa de pelo menos 2 recordes pessoais registrados para ver seu gráfico de progressão 1RM."
          }
        }
      }
    },
    "You're a Pro subscriber": {
      "comment": "Pro status message",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist Pro-Abonnent"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres suscriptor Pro"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres suscriptor Pro"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você é assinante Pro"
          }
        }
      }
    },
    "You're on your longest workout streak ever at %lld days. Building a training habit is the foundation of lasting results.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist bei deiner längsten Workout-Serie überhaupt mit %lld Tagen. Eine Trainingsgewohnheit aufzubauen ist die Grundlage für dauerhafte Ergebnisse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás en tu racha de entrenamiento más larga con %lld días. Crear un hábito de entrenamiento es la base de resultados duraderos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás en tu racha de entrenamiento más larga con %lld días. Crear un hábito de entrenamiento es la base de resultados duraderos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está na sua maior sequência de treinos com %lld dias. Criar um hábito de treino é a base para resultados duradouros."
          }
        }
      }
    },
    "You've completed %lld workouts this month vs %lld last month. Consistency is the strongest predictor of long-term strength gains.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %lld Workouts diesen Monat abgeschlossen gegenüber %lld letzten Monat. Beständigkeit ist der stärkste Indikator für langfristige Kraftzuwächse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You've completed %1$lld workouts this month vs %2$lld last month. Consistency is the strongest predictor of long-term strength gains."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has completado %lld entrenamientos este mes vs %lld el mes pasado. La constancia es el mejor predictor de ganancias de fuerza a largo plazo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Has completado %lld entrenamientos este mes vs %lld el mes pasado. La constancia es el mejor predictor de ganancias de fuerza a largo plazo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você completou %lld treinos este mês vs %lld no mês passado. A consistência é o maior indicador de ganhos de força a longo prazo."
          }
        }
      }
    },
    "You've completed %lld workouts. Most people quit within the first few weeks. You've proven real commitment to your fitness.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %lld Trainingseinheiten abgeschlossen. Die meisten geben innerhalb der ersten Wochen auf. Du hast echtes Engagement für deine Fitness bewiesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has completado %lld entrenamientos. La mayoría abandona en las primeras semanas. Has demostrado un compromiso real con tu fitness."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Has completado %lld entrenamientos. La mayoría abandona en las primeras semanas. Has demostrado un compromiso real con tu fitness."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você completou %lld treinos. A maioria desiste nas primeiras semanas. Você provou um compromisso real com seu condicionamento físico."
          }
        }
      }
    },
    "You've improved on %lld exercises since you started. Keep following progressive overload principles to sustain these gains.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast dich bei %lld Übungen seit dem Start verbessert. Bleib beim Prinzip der progressiven Überlastung, um diese Zuwächse beizubehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has mejorado en %lld ejercicios desde que empezaste. Sigue los principios de sobrecarga progresiva para mantener estos logros."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Has mejorado en %lld ejercicios desde que empezaste. Sigue los principios de sobrecarga progresiva para mantener estos logros."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você melhorou em %lld exercícios desde que começou. Continue seguindo os princípios de sobrecarga progressiva para manter esses ganhos."
          }
        }
      }
    },
    "You've logged %lld workout%@ this month and %lld overall. Staying consistent is what separates short-term effort from lasting results.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %lld Workout%@ diesen Monat und %lld insgesamt protokolliert. Dranbleiben ist das, was kurzfristige Anstrengung von dauerhaften Ergebnissen unterscheidet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You've logged %1$lld workout%2$@ this month and %3$lld overall. Staying consistent is what separates short-term effort from lasting results."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has registrado %lld entrenamiento%@ este mes y %lld en total. Ser constante es lo que separa el esfuerzo a corto plazo de los resultados duraderos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Has registrado %lld entrenamiento%@ este mes y %lld en total. Ser constante es lo que separa el esfuerzo a corto plazo de los resultados duraderos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você registrou %lld treino%@ este mês e %lld no total. Ser consistente é o que separa o esforço a curto prazo de resultados duradouros."
          }
        }
      }
    },
    "You've only trained %@ this month. Full-body balance reduces injury risk and improves overall functional strength.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast diesen Monat nur %@ trainiert. Ganzkörper-Balance reduziert das Verletzungsrisiko und verbessert die funktionelle Gesamtkraft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo has entrenado %@ este mes. El equilibrio de todo el cuerpo reduce el riesgo de lesiones y mejora la fuerza funcional general."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo has entrenado %@ este mes. El equilibrio de todo el cuerpo reduce el riesgo de lesiones y mejora la fuerza funcional general."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você só treinou %@ este mês. O equilíbrio de corpo inteiro reduz o risco de lesões e melhora a força funcional geral."
          }
        }
      }
    },
    "You've trained %lld days straight. Muscle tissue repairs and grows during rest, scheduling a recovery day can actually accelerate your progress.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %lld Tage am Stück trainiert. Muskelgewebe repariert und wächst während der Ruhe – ein Erholungstag kann deinen Fortschritt tatsächlich beschleunigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has entrenado %lld días seguidos. El tejido muscular se repara y crece durante el descanso, programar un día de recuperación puede acelerar tu progreso."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Has entrenado %lld días seguidos. El tejido muscular se repara y crece durante el descanso, programar un día de recuperación puede acelerar tu progreso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você treinou %lld dias seguidos. O tecido muscular se repara e cresce durante o descanso – agendar um dia de recuperação pode acelerar seu progresso."
          }
        }
      }
    },
    "Your %lld-day streak ended, but the strength you built didn't disappear. One session is all it takes to start a new one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine %lld-Tage-Serie ist beendet, aber die aufgebaute Kraft ist nicht verschwunden. Eine Einheit genügt, um eine neue zu starten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu racha de %lld días terminó, pero la fuerza que construiste no desapareció. Una sesión es todo lo que necesitas para empezar una nueva."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu racha de %lld días terminó, pero la fuerza que construiste no desapareció. Una sesión es todo lo que necesitas para empezar una nueva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua sequência de %lld dias terminou, mas a força que você construiu não desapareceu. Uma sessão é tudo que precisa para começar uma nova."
          }
        }
      }
    },
    "Your account and all associated data will be permanently deleted.": {
      "comment": "Delete account warning detail",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto und alle zugehörigen Daten werden dauerhaft gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta y todos los datos asociados serán eliminados permanentemente."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta y todos los datos asociados serán eliminados permanentemente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua conta e todos os dados associados serão excluídos permanentemente."
          }
        }
      }
    },
    "Your average session is %lld minutes. Research shows diminishing returns after 60–75 minutes as cortisol rises. Consider higher-intensity, shorter sessions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine durchschnittliche Einheit dauert %lld Minuten. Studien zeigen abnehmende Erträge nach 60–75 Minuten, da Cortisol ansteigt. Erwäge intensivere, kürzere Einheiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sesión promedio dura %lld minutos. Los estudios muestran rendimientos decrecientes después de 60–75 minutos cuando el cortisol aumenta. Considera sesiones más cortas e intensas."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sesión promedio dura %lld minutos. Los estudios muestran rendimientos decrecientes después de 60–75 minutos cuando el cortisol aumenta. Considera sesiones más cortas e intensas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua sessão média dura %lld minutos. Pesquisas mostram retornos decrescentes após 60–75 minutos com o aumento do cortisol. Considere sessões mais curtas e intensas."
          }
        }
      }
    },
    "Your average session is %lld minutes. Sessions under 20 minutes may not provide enough stimulus. Aim for at least 30–45 minutes to maximize your results.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine durchschnittliche Einheit dauert %lld Minuten. Einheiten unter 20 Minuten bieten möglicherweise nicht genug Reiz. Strebe mindestens 30–45 Minuten an, um deine Ergebnisse zu maximieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sesión promedio dura %lld minutos. Sesiones de menos de 20 minutos pueden no proporcionar suficiente estímulo. Apunta a al menos 30–45 minutos para maximizar tus resultados."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sesión promedio dura %lld minutos. Sesiones de menos de 20 minutos pueden no proporcionar suficiente estímulo. Apunta a al menos 30–45 minutos para maximizar tus resultados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua sessão média dura %lld minutos. Sessões com menos de 20 minutos podem não fornecer estímulo suficiente. Mire em pelo menos 30–45 minutos para maximizar seus resultados."
          }
        }
      }
    },
