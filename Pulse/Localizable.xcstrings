    "Pulse works best with Apple Health. It keeps your workouts running in the background and syncs your data automatically." : {
      "comment" : "HealthKit permission description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse funktioniert am besten mit Apple Health. Es hält deine Workouts im Hintergrund aktiv und synchronisiert deine Daten automatisch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse funciona mejor con Apple Health. Mantiene tus entrenamientos en segundo plano y sincroniza tus datos automáticamente."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse funciona mejor con Apple Health. Mantiene tus entrenamientos en segundo plano y sincroniza tus datos automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse fonctionne mieux avec Apple Health. Tes entraînements restent actifs en arrière-plan et tes données sont synchronisées automatiquement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PulseはApple Healthと一緒に使うと最適です。ワークアウトをバックグラウンドで実行し、データを自動的に同期します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse는 Apple Health와 함께 사용할 때 가장 잘 작동합니다. 운동을 백그라운드에서 계속 실행하고 데이터를 자동으로 동기화합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse werkt het beste met Apple Health. Het houdt je trainingen op de achtergrond actief en synchroniseert je gegevens automatisch."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Pulse funciona melhor com o Apple Health. Ele mantém seus treinos rodando em segundo plano e sincroniza seus dados automaticamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse fungerar bäst med Apple Health. Det håller dina träningspass igång i bakgrunden och synkar din data automatiskt."
          }
        }
      }
    },
