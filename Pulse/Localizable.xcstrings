    "%@ makes up %lld%% of your sets this month. Uneven training can create strength imbalances. Consider adding work for opposing muscle groups.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ makes up %2$lld%% of your sets this month. Uneven training can create strength imbalances. Consider adding work for opposing muscle groups."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ macht %lld%% deiner Sätze diesen Monat aus. Ungleichmäßiges Training kann Kraft-Ungleichgewichte erzeugen. Erwäge, Übungen für die gegenüberliegenden Muskelgruppen hinzuzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ representa el %lld%% de tus series este mes. El entrenamiento desigual puede crear desequilibrios de fuerza. Considera añadir trabajo para los grupos musculares opuestos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ representa el %lld%% de tus series este mes. El entrenamiento desigual puede crear desequilibrios de fuerza. Considera agregar trabajo para los grupos musculares opuestos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ representa %lld%% das suas séries este mês. Treino desigual pode criar desequilíbrios de força. Considere adicionar exercícios para os grupos musculares opostos."
          }
        }
      }
    },
