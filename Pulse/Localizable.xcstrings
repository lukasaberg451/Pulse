          }
        }
      }
    },
    "Your account and all associated data will be permanently deleted." : {
      "comment" : "Delete account warning detail",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto und alle zugehörigen Daten werden dauerhaft gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta y todos los datos asociados serán eliminados permanentemente."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta y todos los datos asociados serán eliminados permanentemente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton compte et toutes les données associées seront supprimés définitivement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントとすべての関連データが完全に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정 및 모든 관련 데이터가 영구적으로 삭제됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je account en alle bijbehorende gegevens worden permanent verwijderd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua conta e todos os dados associados serão excluídos permanentemente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt konto och all tillhörande data raderas permanent."
          }
        }
      }
    },
    "Your average session is %lld minutes. Longer sessions can be effective, but if you're feeling drained, consider higher-intensity shorter sessions to stay fresh." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine durchschnittliche Einheit dauert %lld Minuten. Längere Einheiten können effektiv sein, aber wenn du dich ausgelaugt fühlst, erwäge kürzere Einheiten mit höherer Intensität, um frisch zu bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu sesión promedio dura %lld minutos. Las sesiones más largas pueden ser efectivas, pero si te sientes agotado, considera sesiones más cortas de mayor intensidad para mantenerte fresco."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu sesión promedio dura %lld minutos. Las sesiones más largas pueden ser efectivas, pero si te sientes agotado, considera sesiones más cortas de mayor intensidad para mantenerte fresco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta séance moyenne dure %lld minutes. Les séances plus longues peuvent être efficaces, mais si tu te sens épuisé, essaie des séances plus courtes et plus intenses pour rester frais."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平均セッション時間は%lld分です。長いセッションも効果的ですが、疲れを感じているなら、高強度の短いセッションで体力を維持することを検討してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "평균 세션 시간은 %lld분입니다. 긴 세션도 효과적일 수 있지만, 지치는 느낌이 든다면 더 짧고 강도 높은 세션으로 컨디션을 유지하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gemiddelde sessie duurt %lld minuten. Langere sessies kunnen effectief zijn, maar als je je uitgeput voelt, overweeg dan kortere sessies met hogere intensiteit om fris te blijven."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua sessão média dura %lld minutos. Sessões mais longas podem ser eficazes, mas se você está se sentindo esgotado, considere sessões mais curtas e intensas para se manter disposto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt genomsnittliga pass är %lld minuter. Längre pass kan vara effektiva, men om du känner dig utmattad, överväg kortare pass med högre intensitet för att hålla dig pigg."
          }
        }
      }
    },
    "Your average session is %lld minutes. Sessions under 20 minutes may not provide enough stimulus. Aim for at least 30–45 minutes to maximize your results." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine durchschnittliche Einheit dauert %lld Minuten. Einheiten unter 20 Minuten bieten möglicherweise nicht genug Reiz. Strebe mindestens 30–45 Minuten an, um deine Ergebnisse zu maximieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu sesión promedio dura %lld minutos. Sesiones de menos de 20 minutos pueden no proporcionar suficiente estímulo. Apunta a al menos 30–45 minutos para maximizar tus resultados."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu sesión promedio dura %lld minutos. Sesiones de menos de 20 minutos pueden no proporcionar suficiente estímulo. Apunta a al menos 30–45 minutos para maximizar tus resultados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta séance moyenne dure %lld minutes. Les séances de moins de 20 minutes ne fournissent peut-être pas assez de stimulation. Vise au moins 30–45 minutes pour maximiser tes résultats."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平均セッション時間は%lld分です。20分未満のセッションでは十分な刺激が得られない可能性があります。結果を最大化するために30〜45分を目指しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "평균 세션 시간은 %lld분입니다. 20분 미만의 세션은 충분한 자극을 제공하지 못할 수 있습니다. 결과를 극대화하려면 최소 30-45분을 목표로 하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gemiddelde sessie is %lld minuten. Sessies onder 20 minuten bieden mogelijk niet genoeg stimulans. Richt op minimaal 30-45 minuten om je resultaten te maximaliseren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua sessão média dura %lld minutos. Sessões com menos de 20 minutos podem não fornecer estímulo suficiente. Mire em pelo menos 30–45 minutos para maximizar seus resultados."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt genomsnittliga pass är %lld minuter. Pass under 20 minuter kanske inte ger tillräcklig stimulans. Sikta på minst 30–45 minuter för att maximera dina resultat."
          }
        }
      }
    },
