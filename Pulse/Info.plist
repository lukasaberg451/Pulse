<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.Pulse.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>Pulse</string>
			</array>
		</dict>
		<dict/>
	</array>
	<key>WCSupportsAlwaysOnDisplay</key>
	<true/>
	<key>SUPABASE_URL</key>
	<string>$(SUPABASE_URL)</string>
	<key>SUPABASE_KEY</key>
	<string>$(SUPABASE_KEY)</string>
	<key>POSTHOG_API_KEY</key>
	<string>$(POSTHOG_API_KEY)</string>
	<key>POSTHOG_HOST</key>
	<string>$(POSTHOG_HOST)</string>
	<key>REVENUECAT_API_KEY</key>
	<string>$(REVENUECAT_API_KEY)</string>
	<key>SENTRY_DSN</key>
	<string>$(SENTRY_DSN)</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Pulse uses HealthKit to track your workouts and sync them with Apple Health.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Pulse saves your workout sessions to Apple Health to keep all your fitness data in one place.</string>
</dict>
</plist>
